 "excerpts": [
  {
   "beat_id": "B04",
   "path": "fighter/fighter.gd",
   "start_line": 71,
   "end_line": 74,
   "text": "func _ready() -> void:\n\tsprite = Sprite2D.new()\n\tsprite.centered = false   # offset = -FEET puts the feet on the node origin (was double-shifted when centred)\n\tadd_child(sprite)"
  },
  {
   "beat_id": "B06",
   "path": "fighter/fighter.gd",
   "start_line": 206,
   "end_line": 214,
   "text": "\tif wind >= MAX_WIND:\n\t\treturn                  # full: the key stops turning, no more clicks\n\tcrank_deg += CRANK_DEG_PER_S * dt\n\twhile crank_deg >= 90.0 and wind < MAX_WIND:\n\t\tcrank_deg -= 90.0\n\t\twind = minf(MAX_WIND, wind + WIND_PER_CLICK)\n\t\twind_changed.emit(self, wind)\n\t\trewind_tick.emit(self)\n\tkey_spin = crank_deg"
  },
  {
   "beat_id": "B08",
   "path": "audio/sfx.gd",
   "start_line": 30,
   "end_line": 36,
   "text": "func watch(f: Fighter) -> void:\n\tf.hit_landed.connect(func(_a, attack, blocked): play(attack if attack != \"pop\" else \"jab\", 0.8 if blocked else 1.0))\n\tf.projectile_fired.connect(func(_f): play(\"pop\"))\n\tf.rewind_tick.connect(func(_f): play(\"rewind\", 1.0 + 0.04 * (_f.wind / 100.0)))\n\tf.state_changed.connect(func(_f, _old, new_state):\n\t\tif new_state == Fighter.S.EMPTY:\n\t\t\tplay(\"empty\"))"
  },
  {
   "beat_id": "B11",
   "path": "tests/test_slice.gd",
   "start_line": 207,
   "end_line": 212,
   "text": "func test_mute_does_not_change_game() -> void:\n\tvar a: Array = await scripted_fight(false)\n\tvar b: Array = await scripted_fight(true)\n\tprint(\"      unmuted end state \", a)\n\tprint(\"      muted   end state \", b)\n\tok(a == b, \"sound never decides state: muted run == unmuted run\")"
  }
 ],
