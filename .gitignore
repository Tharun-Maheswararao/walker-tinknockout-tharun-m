# Engine caches and local editor state
.godot/
.DS_Store
.idea/
.vscode/
__pycache__/

# Video and MP3 stay out of GitHub (course rule); game audio is OGG/WAV and IS tracked
*.[mM][pP]3
*.[mM][pP]4
*.avi
*.mov
exports/
builds/
film/capture/
film/media/

# Full-size raw generations live outside the repo (_genai/out); only thumbnails are tracked
raw/

# Local credentials/configuration
.env
.env.*
credentials/

# Film reel media (youtube/): real 4K gameplay and renders, far over the 25MB limit.
# The reel's documents, beat sheet and evidence ledger ARE tracked.
youtube/**/capture/*.mp4
youtube/**/media/
youtube/**/audio/
youtube/**/exports/
youtube/**/clips/
youtube/**/mp3/
youtube/**/_qc/frames/

# Blender auto-backup saves
*.blend1
